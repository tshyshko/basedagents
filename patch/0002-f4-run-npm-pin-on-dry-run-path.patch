From ccb0c5db1323aac5773630d20dd69c5181856616 Mon Sep 17 00:00:00 2001
From: tshyshko <tshyshko@users.noreply.github.com>
Date: Sat, 10 Oct 2026 12:32:14 -0400
Subject: [PATCH 1/2] ci(publish): run the npm@11.21.0 pin on the dry-run path
 too (F4); add push-only dry-run verify workflow

---
 .github/workflows/publish-dryrun-verify.yml | 29 +++++++++++++++++++++
 .github/workflows/publish.yml               |  4 +--
 2 files changed, 31 insertions(+), 2 deletions(-)
 create mode 100644 .github/workflows/publish-dryrun-verify.yml

diff --git a/.github/workflows/publish-dryrun-verify.yml b/.github/workflows/publish-dryrun-verify.yml
new file mode 100644
index 0000000..04dfdcb
--- /dev/null
+++ b/.github/workflows/publish-dryrun-verify.yml
@@ -0,0 +1,29 @@
+# Fork-only verification of audit fix F4: executes the publish.yml sdk/mcp dry-run
+# step sequence (pinned npm -> npm ci -> npm publish --dry-run). push trigger only,
+# contents: read, no id-token, no environment, no secrets. Never writes to a registry.
+name: Publish dry-run verify (F4)
+on:
+  push:
+    branches: [verify/f4-npm-pin]
+permissions:
+  contents: read
+jobs:
+  dryrun:
+    strategy:
+      matrix:
+        pkg: [packages/sdk, packages/mcp]
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262  # v4.4.0
+      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020  # v4.4.0
+        with:
+          node-version: 22
+          cache: npm
+      - name: Pin npm (same command as publish.yml)
+        run: npm install -g npm@11.21.0 && npm --version
+      - name: Assert npm is exactly 11.21.0
+        run: test "$(npm --version)" = "11.21.0"
+      - run: npm ci
+      - name: Dry-run publish (no registry write)
+        run: npm publish --dry-run --workspace=${{ matrix.pkg }}
diff --git a/.github/workflows/publish.yml b/.github/workflows/publish.yml
index 28909a0..6184a04 100644
--- a/.github/workflows/publish.yml
+++ b/.github/workflows/publish.yml
@@ -139,7 +139,7 @@ jobs:
         with:
           node-version: 22
           cache: npm
-      - if: needs.gate.outputs.dry_run != 'true'
+      - name: Pin npm (runs on the dry-run path too, so the pin is exercised in forks)
         run: npm install -g npm@11.21.0 && npm --version  # >= 11.5.1 for trusted publishing; exact pin, not @latest
       - run: npm ci
       - name: Publish if unpublished
@@ -167,7 +167,7 @@ jobs:
         with:
           node-version: 22
           cache: npm
-      - if: needs.gate.outputs.dry_run != 'true'
+      - name: Pin npm (runs on the dry-run path too, so the pin is exercised in forks)
         run: npm install -g npm@11.21.0 && npm --version  # >= 11.5.1 for trusted publishing; exact pin, not @latest
       - run: npm ci
       - name: Publish if unpublished
